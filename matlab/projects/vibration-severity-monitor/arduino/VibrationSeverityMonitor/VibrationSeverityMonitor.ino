// VibrationSeverityMonitor
//
// Runs the vibration severity detector generated by MATLAB Coder (Part 5 of
// Tutorial 2) on an Arduino Nano 33 BLE Sense (Rev1, LSM9DS1).
//
// Every second the sketch records 100 samples of acceleration and angular
// rate at 100 Hz, the same rate and IMU settings used to record the
// training data, runs the detector, and shows the result on the RGB LED:
//   Level 0  no vibration      green
//   Level 1  light vibration   yellow
//   Level 2  strong vibration  red
//   Unrecognized vibration     blue (classifier says level 0, autoencoder disagrees)
// Unrecognized vibration is only shown after kUnrecognizedWindows consecutive
// windows, so a single small bump (a knock on the desk, a touch on the USB
// cable) does not make the LED flicker, while a lasting unfamiliar vibration
// still turns it blue.
//
// Serial output (115200 baud), one CSV line per window:
//   ms,level,state,p0,p1,p2,ae_score,latency_us
// state is what the LED shows; ae_score is the raw score of the window.

#include <Arduino_LSM9DS1.h>

extern "C" {
#include "src/model/vibrationSeverityDetect.h"
#include "src/model/vibrationSeverityDetect_initialize.h"
}

constexpr int kWindowLength = 100;               // samples per window (1 s)
constexpr int kNumChannels = 6;                  // ax ay az gx gy gz
constexpr unsigned long kSamplePeriodUs = 10000; // 100 Hz, as in the recordings
constexpr int kUnrecognizedWindows = 3;          // consecutive windows before blue

// Window stored column by column, as MATLAB arrays are:
// ax[0..99], ay[...], az[...], gx[...], gy[...], gz[...]
static float window[kNumChannels * kWindowLength];

static const char *kStateNames[] = {"NO_VIBRATION", "LIGHT", "STRONG", "UNRECOGNIZED"};

static void setLed(bool red, bool green, bool blue) {
  // The RGB LED on the Nano 33 BLE Sense is active low.
  digitalWrite(LEDR, red ? LOW : HIGH);
  digitalWrite(LEDG, green ? LOW : HIGH);
  digitalWrite(LEDB, blue ? LOW : HIGH);
}

static void recordWindow() {
  unsigned long nextSample = micros();
  for (int i = 0; i < kWindowLength;) {
    if ((long)(micros() - nextSample) >= 0) {
      nextSample += kSamplePeriodUs;
      float ax, ay, az, gx, gy, gz;
      IMU.readAcceleration(ax, ay, az);
      IMU.readGyroscope(gx, gy, gz);
      window[i] = ax;
      window[i + 1 * kWindowLength] = ay;
      window[i + 2 * kWindowLength] = az;
      window[i + 3 * kWindowLength] = gx;
      window[i + 4 * kWindowLength] = gy;
      window[i + 5 * kWindowLength] = gz;
      i++;
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(LEDR, OUTPUT);
  pinMode(LEDG, OUTPUT);
  pinMode(LEDB, OUTPUT);
  setLed(false, true, false);

  // Default library settings: accelerometer and gyroscope at 119 Hz,
  // +/-4 g and +/-2000 deg/s, the same as when the data was recorded.
  if (!IMU.begin()) {
    while (true) {
      Serial.println("ERROR: failed to initialize the LSM9DS1 IMU");
      delay(1000);
    }
  }
  vibrationSeverityDetect_initialize();
  Serial.println("ms,level,state,p0,p1,p2,ae_score,latency_us");
}

void loop() {
  static int unrecognizedCount = 0;

  recordWindow();

  int level;
  float probabilities[3];
  float aeScore;
  bool isUnrecognized;
  unsigned long start = micros();
  vibrationSeverityDetect(window, &level, probabilities, &aeScore, &isUnrecognized);
  unsigned long latency = micros() - start;

  unrecognizedCount = isUnrecognized ? unrecognizedCount + 1 : 0;
  int state = (unrecognizedCount >= kUnrecognizedWindows) ? 3 : level;
  switch (state) {
    case 0: setLed(false, true, false); break;  // green
    case 1: setLed(true, true, false); break;   // yellow
    case 2: setLed(true, false, false); break;  // red
    default: setLed(false, false, true); break; // blue
  }

  Serial.print(millis());
  Serial.print(',');
  Serial.print(level);
  Serial.print(',');
  Serial.print(kStateNames[state]);
  for (int k = 0; k < 3; k++) {
    Serial.print(',');
    Serial.print(probabilities[k], 3);
  }
  Serial.print(',');
  Serial.print(aeScore, 3);
  Serial.print(',');
  Serial.println(latency);
}
